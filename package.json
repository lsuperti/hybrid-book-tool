{
  "name": "hybrid-book-tool",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/check-comments.mjs --mode=production",
    "build": "ng build",
    "check-comments:dev": "node scripts/check-comments.mjs --mode=development",
    "check-comments:prod": "node scripts/check-comments.mjs --mode=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:hybrid-book-tool": "node dist/hybrid-book-tool/server/server.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@12.0.0",
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-server": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/ssr": "^22.0.7",
    "@zip.js/zip.js": "^2.22.0",
    "express": "^5.1.0",
    "mediabunny": "^1.55.4",
    "ngx-extended-pdf-viewer": "^29.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
